# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.claude/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)

# deployment
scripts/deploy*.js
scripts/fix-permissions.js
scripts/inspect-ftp.js
scripts/debug-ftp.js
scripts/test*.js
*.log
build_log*.txt

# secrets
.env*
# ...but .env holds only the unlock service's public origin, which the build
# inlines. Not a secret, and a clone without it silently ships with the licence
# check disabled. Real secrets live in GCP Secret Manager.
!.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated by scripts/build-paid.mjs at image build time. 2.3 MB of paid bank;
# it is a cut of content.json, which is already committed, so committing it too
# would just be a second copy to keep in step.
services/unlock/data/paid.json
